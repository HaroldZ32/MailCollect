{
  "name": "mailcollect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @mailcollect/ui",
    "dev:server": "npm run dev -w @mailcollect/server",
    "dev:desktop": "npm run dev -w @mailcollect/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "smoke": "node scripts/smoke.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@45.2.2": true,
    "electron-winstaller@5.4.0": true
  }
}

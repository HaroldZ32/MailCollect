{
  "name": "@mailcollect/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:web": "node scripts/build-prod.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.mailcollect.app",
    "productName": "MailCollect",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "ui/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
